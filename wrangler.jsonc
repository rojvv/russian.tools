{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "russian-tools",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
